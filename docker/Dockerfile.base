FROM ghcr.io/cyber-dojo-languages/java:5c97081
LABEL maintainer=jon@jaggersoft.com

COPY /jars/* /junit/
ENV CLASSPATH=/junit/

# A kata's test run reads the two AOT caches this leaves in /aot, one for the
# JVM that compiles and one for the JVM that runs the tests, instead of loading
# those classes from the jars again on every [test] press. The script explains
# which classes each holds and why there have to be two.
COPY throwaway_kata /tmp/throwaway_kata
COPY record_aot_caches.sh /tmp
RUN bash /tmp/record_aot_caches.sh \
 && rm -rf /tmp/record_aot_caches.sh /tmp/throwaway_kata
